extends RefCounted

const EventRouletteController = preload("res://scripts/EventRouletteController.gd")
const ControlChamber = preload("res://scripts/ControlChamber.gd")
const Turret = preload("res://scripts/Turret.gd")
const GameConfig = preload("res://scripts/GameConfig.gd")

class DummyMain extends RefCounted:
	var current_score_counts: Dictionary = {}
	var game_elapsed_time: float = 0.0
	var selected_grid_size: int = 40
	var is_game_over: bool = false

	func _init() -> void:
		current_score_counts = {
			GameConfig.Faction.BLUE: 10,
			GameConfig.Faction.RED: 20,
			GameConfig.Faction.GREEN: 30,
			GameConfig.Faction.YELLOW: 40,
		}

	func _show_center_banner(_title: String, _text: String, _color: Color, _important: bool) -> void:
		pass

	func _refresh_add_ball_button(_faction_id: int) -> void:
		pass

class TestController extends EventRouletteController:
	var scripted_effects: Array[String] = []
	var scripted_faction_id: int = GameConfig.Faction.BLUE

	func _random_effect() -> String:
		if scripted_effects.is_empty():
			return EFFECT_BONUS_10
		return scripted_effects.pop_front()

	func _choose_faction_for_effect(_effect_name: String) -> int:
		return scripted_faction_id

func get_test_name() -> String:
	return "TestEventRoulette"

func run(asserts, tree: SceneTree) -> void:
	asserts.expect_eq(EventRouletteController.EFFECT_REROLL, "reroll", "reroll effect constant should exist")
	asserts.expect_eq(EventRouletteController.EFFECT_BONUS_10, "bonus_10", "bonus_10 effect constant should exist")
	asserts.expect_eq(EventRouletteController.EFFECT_X2, "x2", "x2 effect constant should exist")
	asserts.expect_eq(EventRouletteController.EFFECT_X3, "x3", "x3 effect constant should exist")
	asserts.expect_eq(EventRouletteController.EFFECT_ADD_BALL, "add_ball", "add_ball effect constant should exist")
	asserts.expect_eq(EventRouletteController.EFFECT_JAM, "jam", "jam effect constant should exist")

	var controller: TestController = TestController.new()
	controller.main_ref = DummyMain.new()
	controller.battlefield = Node.new()
	controller.scripted_faction_id = GameConfig.Faction.GREEN
	controller.scripted_effects = [
		EventRouletteController.EFFECT_REROLL,
		EventRouletteController.EFFECT_X3,
	]
	var sequence: Array = []
	var resolved_effect: String = controller._roll_effect_sequence(sequence)
	asserts.expect_eq(resolved_effect, EventRouletteController.EFFECT_X3, "reroll should re-roll effect only")
	asserts.expect_eq(sequence.size(), 2, "reroll sequence should keep only effect rolls")

	controller.scripted_effects = [
		EventRouletteController.EFFECT_REROLL,
		EventRouletteController.EFFECT_REROLL,
		EventRouletteController.EFFECT_REROLL,
	]
	sequence.clear()
	resolved_effect = controller._roll_effect_sequence(sequence)
	asserts.expect_eq(resolved_effect, EventRouletteController.EFFECT_BONUS_10, "reroll should fall back to +10 after two rerolls")
	asserts.expect_eq(sequence[sequence.size() - 1], EventRouletteController.EFFECT_BONUS_10, "forced reroll fallback should append bonus_10")

	asserts.expect_true(
		controller._weight_for_effect_rank(EventRouletteController.EFFECT_BONUS_10, 4) > controller._weight_for_effect_rank(EventRouletteController.EFFECT_BONUS_10, 1),
		"positive events should favor trailing factions"
	)
	asserts.expect_true(
		controller._weight_for_effect_rank(EventRouletteController.EFFECT_JAM, 1) > controller._weight_for_effect_rank(EventRouletteController.EFFECT_JAM, 4),
		"negative events should favor leading factions"
	)
	asserts.expect_eq(controller._weight_for_effect_rank(EventRouletteController.EFFECT_REROLL, 1), 1.0, "neutral reroll weight should be equal")
	asserts.expect_eq(controller._weight_for_effect_rank(EventRouletteController.EFFECT_REROLL, 4), 1.0, "neutral reroll weight should be equal for all ranks")

	var chamber: ControlChamber = ControlChamber.new()
	var turret: Turret = Turret.new()
	tree.root.add_child(chamber)
	tree.root.add_child(turret)
	await tree.process_frame

	controller.chambers = {GameConfig.Faction.GREEN: chamber}
	controller.turrets = {GameConfig.Faction.GREEN: turret}
	chamber.pending_count = 6
	controller._apply_resolved_event({
		"faction_id": GameConfig.Faction.GREEN,
		"final_effect": EventRouletteController.EFFECT_X2,
	})
	asserts.expect_eq(chamber.get_pending_count(), 12, "controller should apply positive event to target chamber")

	chamber.pending_count = 10
	chamber.set_locked(true)
	controller._apply_positive_modifier(chamber, {"type": EventRouletteController.EFFECT_X3, "multiplier": 3})
	asserts.expect_eq(chamber.get_pending_count(), 10, "locked chamber should not change current pending_count immediately")
	asserts.expect_eq(chamber.get_queued_modifier_count(), 1, "locked chamber should queue positive event modifiers")
	chamber.set_locked(false)

	asserts.expect_true(controller.view_ref == null, "controller logic should work without a view attached")

	chamber.queue_free()
	turret.queue_free()
	await tree.process_frame
