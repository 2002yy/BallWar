extends SceneTree

const Battlefield = preload("res://scripts/Battlefield.gd")
const BulletPool = preload("res://scripts/BulletPool.gd")
const BulletTrailLayer = preload("res://scripts/BulletTrailLayer.gd")
const Turret = preload("res://scripts/Turret.gd")
const GameConfig = preload("res://scripts/GameConfig.gd")

const RUN_DURATION_SECONDS: float = 10.0
const REPORT_PATH: String = "user://test_reports/perf_burst_benchmark.json"

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var report: Dictionary = {
		"engine": Engine.get_version_info(),
		"quality": "medium",
		"grid_size": 40,
		"duration_seconds": RUN_DURATION_SECONDS,
		"runs": [],
	}

	for pending_count in [512, 1024, 2048]:
		var run_metrics: Dictionary = await _run_single_case(pending_count)
		report["runs"].append(run_metrics)

	_write_report(report)
	print("[PerfBurstBenchmark] Wrote %s" % REPORT_PATH)
	quit(0)

func _run_single_case(pending_count: int) -> Dictionary:
	GameConfig.set_quality_by_name(GameConfig.QUALITY_MEDIUM)
	GameConfig.set_game_mode_by_name(GameConfig.GAME_MODE_BASIC)

	var root: Node2D = Node2D.new()
	root.name = "PerfRoot"
	self.root.add_child(root)

	var battlefield: Battlefield = Battlefield.new()
	battlefield.configure(40)
	root.add_child(battlefield)

	var trail_layer: BulletTrailLayer = BulletTrailLayer.new()
	root.add_child(trail_layer)

	var bullet_pool: BulletPool = BulletPool.new()
	root.add_child(bullet_pool)
	bullet_pool.set_trail_layer(trail_layer)

	var turrets: Dictionary = _create_benchmark_turrets(root, battlefield, bullet_pool)
	if bullet_pool.has_method("set_tracked_turrets"):
		bullet_pool.set_tracked_turrets(turrets)

	await process_frame

	var start_usec: int = Time.get_ticks_usec()
	var fps_sum: float = 0.0
	var fps_samples: int = 0
	var min_fps: int = 999999
	var active_bullets_peak: int = 0
	var queue_peak: int = 0

	var benchmark_turret: Turret = turrets.get(GameConfig.Faction.BLUE, null)
	if benchmark_turret != null:
		benchmark_turret.fire_burst(pending_count)

	while float(Time.get_ticks_usec() - start_usec) / 1000000.0 < RUN_DURATION_SECONDS:
		await process_frame

		if benchmark_turret != null and not benchmark_turret.is_destroyed and benchmark_turret.burst_remaining <= 0:
			benchmark_turret.fire_burst(pending_count)

		var fps: int = floori(Engine.get_frames_per_second())
		if fps > 0:
			fps_sum += float(fps)
			fps_samples += 1
			min_fps = mini(min_fps, fps)

		active_bullets_peak = maxi(active_bullets_peak, bullet_pool.get_active_count())
		queue_peak = maxi(queue_peak, _sum_turret_queue(turrets))

	var battlefield_metrics: Dictionary = battlefield.get_debug_metrics()
	var trail_metrics: Dictionary = trail_layer.get_debug_metrics() if trail_layer.has_method("get_debug_metrics") else {}
	var bullet_metrics: Dictionary = bullet_pool.get_debug_metrics() if bullet_pool.has_method("get_debug_metrics") else {}

	root.queue_free()
	await process_frame

	return {
		"pending_count": pending_count,
		"avg_fps": (fps_sum / float(fps_samples)) if fps_samples > 0 else 0.0,
		"min_fps": 0 if min_fps == 999999 else min_fps,
		"active_bullets_peak": active_bullets_peak,
		"queue_peak": queue_peak,
		"spawned_bullets_per_second": float(bullet_metrics.get("spawned_bullets_per_second", 0.0)),
		"capture_changes_per_second": int(battlefield_metrics.get("cell_changes_per_second", 0)),
		"battlefield_redraws_per_second": int(battlefield_metrics.get("redraw_calls_per_second", 0)),
		"trail_segments_estimate": int(bullet_metrics.get("trail_segments_estimate", 0)),
		"trail_layer_redraws_per_second": int(trail_metrics.get("redraw_calls_per_second", 0)),
	}

func _create_benchmark_turrets(parent: Node, battlefield: Battlefield, bullet_pool: BulletPool) -> Dictionary:
	var size: float = float(battlefield.grid_size * battlefield.cell_size)
	var map_origin: Vector2 = battlefield.global_position
	var turret_positions: Dictionary = {
		GameConfig.Faction.BLUE: map_origin + Vector2(-22.0, -22.0),
		GameConfig.Faction.RED: map_origin + Vector2(size + 22.0, -22.0),
		GameConfig.Faction.GREEN: map_origin + Vector2(-22.0, size + 22.0),
		GameConfig.Faction.YELLOW: map_origin + Vector2(size + 22.0, size + 22.0),
	}
	var result: Dictionary = {}
	for faction_id in turret_positions.keys():
		var turret: Turret = Turret.new()
		parent.add_child(turret)
		turret.setup(int(faction_id), turret_positions[faction_id], battlefield, bullet_pool)
		result[int(faction_id)] = turret
	for faction_id in result.keys():
		var turret: Turret = result[faction_id]
		turret.set_all_turrets(result)
	return result

func _sum_turret_queue(turrets: Dictionary) -> int:
	var total: int = 0
	for turret in turrets.values():
		if turret != null and is_instance_valid(turret):
			total += int(turret.burst_remaining)
	return total

func _write_report(report: Dictionary) -> void:
	var report_dir: String = ProjectSettings.globalize_path("user://test_reports")
	DirAccess.make_dir_recursive_absolute(report_dir)
	var file: FileAccess = FileAccess.open(REPORT_PATH, FileAccess.WRITE)
	if file == null:
		push_error("[PerfBurstBenchmark] Failed to open report path: %s" % REPORT_PATH)
		return
	file.store_string(JSON.stringify(report, "\t"))
	file.close()
