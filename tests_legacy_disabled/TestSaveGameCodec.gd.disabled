extends RefCounted

const SaveGameCodec = preload("res://scripts/SaveGameCodec.gd")
const GameConfig = preload("res://scripts/GameConfig.gd")

func get_test_name() -> String:
	return "TestSaveGameCodec"

func run(asserts, _tree: SceneTree) -> void:
	GameConfig.set_game_mode_by_name(GameConfig.GAME_MODE_BASIC)

	var legacy_save: Dictionary = {
		"save_version": "1.9.35",
		"grid_size": 40,
		"quality_name": GameConfig.get_quality_name(),
		"game_mode_name": GameConfig.get_game_mode_name(),
		"time_limit_minutes": GameConfig.DEFAULT_TIMED_MODE_MINUTES,
		"owners": [],
		"bullets": [],
		"factions": [
			{
				"faction_id": 0,
				"chamber_pending_count": 12,
			}
		],
	}
	var clean_legacy: Dictionary = SaveGameCodec.validate_save_data(legacy_save)
	asserts.expect_true(clean_legacy.get("event_state", null) is Dictionary, "missing event_state should be defaulted")
	asserts.expect_eq(float(clean_legacy["event_state"].get("next_event_time_left", -1.0)), 0.0, "missing next_event_time_left should default to 0")
	asserts.expect_eq(int(clean_legacy["event_state"].get("last_event_faction", -99)), -1, "missing last_event_faction should default to -1")
	asserts.expect_eq(str(clean_legacy["event_state"].get("last_event_effect", "missing")), "", "missing last_event_effect should default to empty")
	asserts.expect_eq(float(clean_legacy["factions"][0].get("chamber_jammed_time_left", -1.0)), 0.0, "missing chamber_jammed_time_left should default to 0")
	asserts.expect_true(clean_legacy["factions"][0].get("queued_round_modifiers", null) is Array, "missing queued modifiers should default to empty array")

	var saved_state: Dictionary = {
		"save_version": "1.9.36",
		"grid_size": 40,
		"quality_name": GameConfig.get_quality_name(),
		"game_mode_name": GameConfig.get_game_mode_name(),
		"time_limit_minutes": GameConfig.DEFAULT_TIMED_MODE_MINUTES,
		"owners": [],
		"bullets": [],
		"event_state": {
			"event_roulette_enabled": true,
			"next_event_time_left": 33.5,
			"current_event_interval": 45.0,
			"last_event_faction": 2,
			"last_event_effect": "x3",
			"reroll_count": 1,
		},
		"factions": [
			{
				"faction_id": 1,
				"chamber_pending_count": 9,
				"chamber_jammed_time_left": 2.5,
				"queued_round_modifiers": [
					{"type": "bonus_10", "amount": 10},
					{"type": "x2", "multiplier": 2},
				],
			}
		],
	}
	var clean_saved: Dictionary = SaveGameCodec.validate_save_data(saved_state)
	asserts.expect_eq(float(clean_saved["event_state"].get("next_event_time_left", 0.0)), 33.5, "event countdown should survive save validation")
	asserts.expect_eq(int(clean_saved["event_state"].get("last_event_faction", -1)), 2, "last_event_faction should survive save validation")
	asserts.expect_eq(str(clean_saved["event_state"].get("last_event_effect", "")), "x3", "last_event_effect should survive save validation")
	asserts.expect_eq(float(clean_saved["factions"][0].get("chamber_jammed_time_left", 0.0)), 2.5, "jammed time should survive save validation")
	asserts.expect_eq((clean_saved["factions"][0].get("queued_round_modifiers", []) as Array).size(), 2, "queued modifiers should survive save validation")

	var clean_saved_again: Dictionary = SaveGameCodec.validate_save_data(clean_saved)
	asserts.expect_eq((clean_saved_again["factions"][0].get("queued_round_modifiers", []) as Array).size(), 2, "queued modifiers should not duplicate on repeated validation")
