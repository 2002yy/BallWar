extends SceneTree

const TestAssert = preload("res://tests/TestAssert.gd")

var _results: Array[Dictionary] = []
var _total_passed: int = 0
var _total_failed: int = 0

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	print("[TestRunner] Discovering tests...")
	var tests: Array[String] = _discover_tests()
	if tests.is_empty():
		push_error("[TestRunner] ERROR: no test files found under res://tests")
		quit(1)
		return

	for path in tests:
		await _run_single_test(path)

	print("")
	print("[TestRunner] Summary")
	print("[TestRunner] Passed assertions: %d" % _total_passed)
	print("[TestRunner] Failed assertions: %d" % _total_failed)
	print("[TestRunner] Test files: %d" % _results.size())

	if _total_failed > 0:
		push_error("[TestRunner] ERROR: some tests failed")
		quit(1)
		return

	print("[TestRunner] PASS")
	quit(0)

func _discover_tests() -> Array[String]:
	var found: Array[String] = []
	var dir: DirAccess = DirAccess.open("res://tests")
	if dir == null:
		return found
	dir.list_dir_begin()
	while true:
		var name: String = dir.get_next()
		if name == "":
			break
		if dir.current_is_dir():
			continue
		if not name.begins_with("Test"):
			continue
		if not name.ends_with(".gd"):
			continue
		if name == "TestRunner.gd" or name == "TestAssert.gd":
			continue
		found.append("res://tests/%s" % name)
	dir.list_dir_end()
	found.sort()
	return found

func _run_single_test(path: String) -> void:
	print("")
	print("[TestRunner] Running %s" % path.get_file())
	var script = load(path)
	if script == null:
		_total_failed += 1
		push_error("[TestRunner] ERROR: failed to load %s" % path)
		return

	var test_object = script.new()
	var asserts: TestAssert = TestAssert.new()
	if test_object == null:
		_total_failed += 1
		push_error("[TestRunner] ERROR: failed to instantiate %s" % path)
		return

	var test_name: String = path.get_file().trim_suffix(".gd")
	if test_object.has_method("get_test_name"):
		test_name = str(test_object.get_test_name())

	if not test_object.has_method("run"):
		_total_failed += 1
		push_error("[TestRunner] ERROR: %s has no run(asserts, tree) method" % test_name)
		return

	await test_object.run(asserts, self)

	_total_passed += asserts.passed
	_total_failed += asserts.failed
	_results.append({
		"name": test_name,
		"passed": asserts.passed,
		"failed": asserts.failed,
		"failures": asserts.failures.duplicate(),
	})

	if asserts.failed > 0:
		push_error("[TestRunner] FAIL %s (%d failures)" % [test_name, asserts.failed])
		for failure in asserts.failures:
			push_error("  - %s" % failure)
		return

	print("[TestRunner] PASS %s (%d checks)" % [test_name, asserts.passed])
