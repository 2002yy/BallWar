extends RefCounted

const Battlefield = preload("res://scripts/Battlefield.gd")
const GameConfig = preload("res://scripts/GameConfig.gd")

func get_test_name() -> String:
	return "TestBattlefield"

func run(asserts, tree: SceneTree) -> void:
	for grid_size in [40, 50, 60]:
		var battlefield: Battlefield = Battlefield.new()
		battlefield.configure(grid_size)
		tree.root.add_child(battlefield)
		await tree.process_frame

		var counts: Dictionary = battlefield.count_cells_by_team()
		var total_cells: int = 0
		for value in counts.values():
			total_cells += int(value)
		asserts.expect_eq(total_cells, grid_size * grid_size, "owner counts should sum to grid size squared")

		var blue_cell: Vector2i = Vector2i(0, 0)
		asserts.expect_eq(battlefield.apply_bullet(blue_cell, GameConfig.Faction.BLUE), "SAME_CELL", "same-color bullet should return SAME_CELL")

		var old_owner: int = int(battlefield.owners[blue_cell.x][blue_cell.y])
		asserts.expect_eq(old_owner, GameConfig.Faction.BLUE, "top-left quadrant should start as blue")
		var result: String = battlefield.apply_bullet(blue_cell, GameConfig.Faction.RED)
		asserts.expect_eq(result, "HIT_ENEMY_CELL", "enemy-color bullet should capture the cell")
		asserts.expect_eq(int(battlefield.owners[blue_cell.x][blue_cell.y]), GameConfig.Faction.RED, "captured cell owner should change")

		var counts_after: Dictionary = battlefield.count_cells_by_team()
		asserts.expect_eq(int(counts_after.get(GameConfig.Faction.BLUE, 0)), int(counts.get(GameConfig.Faction.BLUE, 0)) - 1, "blue count should decrease after losing a cell")
		asserts.expect_eq(int(counts_after.get(GameConfig.Faction.RED, 0)), int(counts.get(GameConfig.Faction.RED, 0)) + 1, "red count should increase after capturing a cell")

		battlefield.flush_visual_update()
		asserts.expect_true(true, "flush_visual_update should complete without error")

		var metrics: Dictionary = battlefield.get_debug_metrics()
		asserts.expect_true(metrics.has("redraw_calls_per_second"), "battlefield debug metrics should expose redraw count")
		asserts.expect_true(metrics.has("cell_changes_per_second"), "battlefield debug metrics should expose capture changes count")

		battlefield.queue_free()
		await tree.process_frame
