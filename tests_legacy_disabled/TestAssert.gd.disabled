extends RefCounted

var passed: int = 0
var failed: int = 0
var failures: Array[String] = []

func expect_true(condition: bool, message: String) -> void:
	if condition:
		passed += 1
		return
	failed += 1
	failures.append(message)

func expect_false(condition: bool, message: String) -> void:
	expect_true(not condition, message)

func expect_eq(actual, expected, message: String) -> void:
	if actual == expected:
		passed += 1
		return
	failed += 1
	failures.append("%s | expected=%s actual=%s" % [message, str(expected), str(actual)])

func expect_ne(actual, unexpected, message: String) -> void:
	if actual != unexpected:
		passed += 1
		return
	failed += 1
	failures.append("%s | unexpected=%s" % [message, str(unexpected)])

func merge(other: TestAssert) -> void:
	if other == null:
		return
	passed += other.passed
	failed += other.failed
	failures.append_array(other.failures)
