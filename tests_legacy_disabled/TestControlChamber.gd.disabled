extends RefCounted

const ControlChamber = preload("res://scripts/ControlChamber.gd")
const GameConfig = preload("res://scripts/GameConfig.gd")

func get_test_name() -> String:
	return "TestControlChamber"

func run(asserts, tree: SceneTree) -> void:
	GameConfig.set_game_mode_by_name(GameConfig.GAME_MODE_BASIC)

	var chamber: ControlChamber = ControlChamber.new()
	tree.root.add_child(chamber)
	await tree.process_frame

	chamber.pending_count = 10
	chamber.apply_pending_bonus(10)
	asserts.expect_eq(chamber.get_pending_count(), 20, "apply_pending_bonus should increase pending_count")

	chamber.apply_pending_multiplier(2)
	asserts.expect_eq(chamber.get_pending_count(), 40, "apply_pending_multiplier(2) should double pending_count")

	chamber.pending_count = 7
	chamber.apply_pending_multiplier(3)
	asserts.expect_eq(chamber.get_pending_count(), 21, "apply_pending_multiplier(3) should triple pending_count")

	chamber.pending_count = 2040
	chamber.apply_pending_bonus(100)
	asserts.expect_eq(chamber.get_pending_count(), 2048, "non-wild modes should clamp pending_count to 2048")

	GameConfig.set_game_mode_by_name(GameConfig.GAME_MODE_WILD)
	chamber.pending_count = 2180
	chamber.apply_pending_bonus(100)
	asserts.expect_eq(chamber.get_pending_count(), 2187, "wild mode should clamp pending_count to 2187")

	GameConfig.set_game_mode_by_name(GameConfig.GAME_MODE_BASIC)
	chamber.set_locked(true)
	var pending_before_queue: int = chamber.get_pending_count()
	chamber.queue_next_round_modifier({"type": "bonus_10", "amount": 10})
	asserts.expect_eq(chamber.get_pending_count(), pending_before_queue, "queued modifier should not change current locked burst")
	asserts.expect_eq(chamber.get_queued_modifier_count(), 1, "queued modifier should be stored while locked")
	chamber.set_locked(false)

	var start_ball_count: int = chamber.get_ball_count()
	chamber.add_control_ball_from_event()
	asserts.expect_eq(chamber.get_ball_count(), start_ball_count + 1, "add_control_ball_from_event should add a ball when not full")

	while chamber.get_ball_count() < GameConfig.MAX_CONTROL_BALLS_PER_CHAMBER:
		chamber.add_control_ball()
	var pending_before_full: int = chamber.get_pending_count()
	chamber.add_control_ball_from_event()
	asserts.expect_eq(chamber.get_pending_count(), pending_before_full + 10, "full chamber add-ball event should convert to +10 pending")

	chamber.apply_jammed(5.0)
	asserts.expect_true(chamber.is_jammed(), "apply_jammed should put chamber into jammed state")

	var jam_ball = chamber.balls[0]
	var jam_pending_before: int = chamber.get_pending_count()
	jam_ball.position = Vector2(chamber.chamber_size.x * 0.20, chamber.chamber_size.y - jam_ball.radius)
	jam_ball.velocity = Vector2.ZERO
	chamber._physics_process(0.016)
	asserts.expect_eq(chamber.get_pending_count(), jam_pending_before, "jammed gate should not trigger left or right gate effects")
	asserts.expect_true(jam_ball.velocity.y < 0.0, "jammed floor should bounce the ball upward")

	chamber.set_jammed_time_left(0.01)
	chamber._process(0.02)
	asserts.expect_false(chamber.is_jammed(), "jammed state should end after timer runs out")

	chamber.set_damaged()
	chamber.apply_jammed(5.0)
	asserts.expect_true(chamber.is_damaged, "damaged chamber should stay damaged")
	asserts.expect_false(chamber.is_jammed(), "damaged chamber should not be restored into jammed state")

	chamber.queue_free()
	await tree.process_frame
